{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "docker:up": "docker compose up -d",
        "docker:down": "docker compose down",
        "docker:build": "docker compose build",
        "docker:migrate": "docker compose exec app php artisan migrate",
        "docker:seed": "docker compose exec app php artisan db:seed",
        "docker:fresh": "docker compose exec app php artisan migrate:fresh --seed",
        "docker:test": "docker compose exec app vendor/bin/pest",
        "docker:pint": "docker compose exec app vendor/bin/pint",
        "docker:bash": "docker compose exec app bash"
    },
    "devDependencies": {
        "@inertiajs/vue3": "^3.6.1",
        "@lucide/vue": "^1.27.0",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.1.2",
        "@types/three": "^0.174.0",
        "@vitejs/plugin-vue": "^6.0.8",
        "concurrently": "^9.0.1",
        "gsap": "^3.12.7",
        "laravel-echo": "^2.4.0",
        "laravel-vite-plugin": "^3.1",
        "lenis": "^1.1.20",
        "lucide-vue-next": "^1.0.0",
        "pusher-js": "^8.6.0",
        "tailwindcss": "^4.3.3",
        "three": "^0.174.0",
        "typescript": "^7.0.2",
        "vite": "^8.0.0",
        "vue": "^3.5.40"
    },
    "dependencies": {
        "@types/leaflet": "^1.9.22",
        "@types/supercluster": "^7.1.3",
        "axios": "^1.19.0",
        "leaflet": "^1.9.4",
        "supercluster": "^8.0.1"
    }
}
